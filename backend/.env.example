# Copy to .env and adjust. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://healthcare:healthcare_dev_password@localhost:5432/healthcare_dev
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Authentication. Generate a secret with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
JWT_ISSUER=healthcare-backend
COOKIE_SECURE=true
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15

# Email: "file" writes emails to DEV_MAIL_DIR (development only); "disabled" sends nothing
# (a deployment without an email service: password reset is unavailable); "ses" sends through Amazon SES
# from EMAIL_FROM (an address verified in SES; credentials from the AWS role).
EMAIL_BACKEND=file
# EMAIL_FROM=Healthfolio <you@example.com>
DEV_MAIL_DIR=.dev_mail

# Documents
DOCUMENT_STORAGE_DIR=storage/documents
# "local" (DOCUMENT_STORAGE_DIR) or "s3" (private bucket; credentials from the AWS role or AWS_* variables)
STORAGE_BACKEND=local
# S3_BUCKET=
UPLOAD_RATE_LIMIT_PER_HOUR=30
SUMMARY_RATE_LIMIT_PER_HOUR=20

# AI extraction (off by default; synthetic documents only until a privacy review)
EXTRACTION_ENABLED=false
# GROQ_API_KEY=  # add your own key here; never commit it
AI_MODEL=qwen/qwen3.8-27b
# OCR for scanned copies (Tesseract must be installed separately). Found automatically on PATH or in
# C:\Program Files\Tesseract-OCR; set the full path here otherwise.
# TESSERACT_CMD=
# Scanned pages read with less average OCR confidence than this go to the AI as images instead.
OCR_MIN_CONFIDENCE=85
EXTRACTION_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2
